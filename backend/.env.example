# Copy to backend/.env and fill in. Everything except MONGO_URI has a working development default.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB: local server or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/udyam_digital

# Security: long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Cloudflare R2 document storage (S3-compatible). Leave empty to store documents in backend/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: full endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com (EU jurisdiction: https://<account_id>.eu.r2.cloudflarestorage.com)
R2_ENDPOINT=

# GenAI advisor (optional). With a key the advisor uses Claude; without it, local multilingual rules.
ANTHROPIC_API_KEY=
# auto | on | off
ADVISOR_AI=auto

# Super admin created on first start and by `npm run create-admin`
ADMIN_EMAIL=admin@udyam.demo
ADMIN_PASSWORD=

# Demo behaviour
DEMO_MODE=true
OTP_DEV_MODE=true
DEMO_STAFF_PASSWORD=Demo@12345
KYC_REFERENCE_DATE=2026-07-15
ABANDON_AFTER_MINUTES=1440
SCHEDULER_SECONDS=60

# WhatsApp (optional). Meta WhatsApp Cloud API; without these the WhatsApp channel runs in the in-app simulator (/whatsapp).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
